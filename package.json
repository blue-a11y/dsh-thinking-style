{
  "name": "@blue-a11y/dsh-thinking-style",
  "description": "Restore the original DeepSeek Harness Thinking style: typography, blue shimmer, sweeping highlights, and a choice of thinking language.",
  "version": "1.0.1",
  "type": "module",
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "license": "MIT",
  "author": "blue-a11y",
  "homepage": "https://github.com/blue-a11y/dsh-thinking-style#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blue-a11y/dsh-thinking-style.git"
  },
  "bugs": {
    "url": "https://github.com/blue-a11y/dsh-thinking-style/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "thinking",
    "theme"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "check": "node --check index.js && node --check client.js",
    "test": "node --test",
    "prepack": "npm run check && npm test"
  }
}
